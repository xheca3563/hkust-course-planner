# Supabase Configuration
# Copy this file to .env and fill in the values from your Supabase project.
# Supabase Dashboard → Project Settings → API
# The anon key is safe to use in the browser (RLS restricts access to each user's own data).
# NEVER put the service_role key here — it bypasses all row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Backend API base URL — only needed in production (local dev uses the Vite proxy).
# Point it at your deployed backend, including the /api suffix:
# VITE_API_URL=https://YOUR-BACKEND.onrender.com/api
